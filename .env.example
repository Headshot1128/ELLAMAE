# Load with your service manager, shell, or uvicorn --env-file .env.
# SQLite is embedded: the database file and its OS permissions are the credential boundary.
AUTH_DATABASE=data/auth.db
AUTH_STORAGE=data/private
AUTH_REGISTRATION=false
# Only this account can manage users and grant website login approval.
AUTH_OWNER_USERNAME=gerry2.0
# Optional override for the server-only license display encryption key.
# Default: AUTH_DATABASE + .license-key. Keep this file private and back it up separately.
# AUTH_LICENSE_KEY_FILE=data/license-display.license-key
# TLS private keys are referenced in uvicorn flags, never copied into the SDK.
# No master API key or token-signing secret exists: random token hashes live in the DB.
